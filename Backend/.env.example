# Backend environment variables for deployment

# MongoDB Atlas connection string (required in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/apnastore?retryWrites=true&w=majority

# Frontend URL for CORS
CLIENT_URL=https://yourfrontend.example.com

# JWT secret used for auth tokens
JWT_SECRET=YourStrongJWTSecret

# Optional: set to production in deployment environments
NODE_ENV=production
